# Database Configuration
DATABASE_URL=sqlite:///./investigation.db

# Email Configuration (Brevo)
# SMTP values are optional and mainly for local/dev. On Render, prefer the HTTPS API.
EMAIL_ENABLED=true
SMTP_ENABLED=false
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=your-verified-email@example.com
MAIL_FROM_NAME=Cybercrime Investigation System
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
USE_CREDENTIALS=true
VALIDATE_CERTS=true

# Brevo HTTPS API key (REQUIRED for Render). Use your xkeysib-... key here.
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-YOUR_BREVO_API_KEY_HERE

# Security
SECRET_KEY=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_BOOTSTRAP_ENABLED=false
SUPERADMIN_BOOTSTRAP_FORCE_RESET=false
SUPERADMIN_BOOTSTRAP_TOKEN=

# Frontend
# Set to your Render frontend URL (defaults to https://cybercrime-frontend.onrender.com if not set)
FRONTEND_BASE_URL=https://cybercrime-frontend.onrender.com

# API Docs
EXPOSE_API_DOCS=false

# RBAC
RBAC_POLICY_PATH=rbac-permissions.json

# Sovereign Integrations (BHIV)
# Application-level contracts only; do not expose internal Core/Bucket details.
BHIV_BUCKET_EVIDENCE_URL=
BHIV_BUCKET_API_KEY=
BHIV_CORE_EVENT_URL=
BHIV_INTEGRATION_TIMEOUT_SECONDS=10
EVENT_RETRY_MAX_ATTEMPTS=3
EVENT_BUFFER_PATH=./event_buffer/events.jsonl
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_EVENT_TOPIC=cybercrime-governance-events

# BHIV runtime bridge (TANTRA + VAJRA). Leave a URL empty to disable that integration.
# TANTRA layer (bhiv-TANTRA_Layer): validation :8101, karma helper :8102, PRANA :8103
TANTRA_VALIDATION_URL=
TANTRA_KARMA_URL=
TANTRA_PRANA_URL=
TANTRA_REGISTRY=prana.event.contracts
# Must be a TANTRA-registered event type; 'security_decision' is not registered yet (TANTRA team action)
TANTRA_EVENT_TYPE=security_decision
TANTRA_CONTRACT_VERSION=1.0.0
TANTRA_SOURCE_SYSTEM=cybersecurity
# Prefix added to every TANTRA submission id (use cyber-p0-test- for test traffic)
TANTRA_SUBMISSION_PREFIX=
# VAJRA relay node HTTP API (default port 8080; 4000 is the P2P port, not the API). Use https in production.
VAJRA_API_URL=
# Bearer token for VAJRA write routes. Issuer UNKNOWN (VAJRA's code calls it the TANTRA secret).
# VAJRA does not scope it: it also authorizes VAJRA authority transitions - treat as high privilege.
# Never commit a real value.
VAJRA_TANTRA_SECRET=
BHIV_RUNTIME_TIMEOUT_SECONDS=5
# A repeated idempotency key replays an earlier ALLOW only inside this window (and only if VAJRA re-confirms)
PROTECTED_ACCESS_REPLAY_TTL_SECONDS=300
# Peer reachability probes on /api/v1/system/health are cached this many seconds
BHIV_HEALTH_CACHE_SECONDS=15
# Requests per caller per minute on POST /api/v1/protected/access (per process; 0 disables)
PROTECTED_ACCESS_RATE_LIMIT_PER_MINUTE=60
# Login attempts per email per minute before 429 (per process; 0 disables)
LOGIN_MAX_ATTEMPTS_PER_MINUTE=20
# Wallet incident analysis reads only the system's own transaction dataset. true = generated DEMO data (labelled synthetic) for
# wallets with no history. Never true for real investigations.
INCIDENT_SYNTHETIC_DEMO=false

# API Configuration
HOST=0.0.0.0
PORT=3000
DEBUG=false
