# BlackHole Blockchain — Environment Variables
# Copy this file to .env on the VM before running docker compose
# Command: cp .env.example .env
# NEVER commit .env to git

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── MongoDB (local container — no Atlas needed) ───────────────────────────────
# These credentials are used by the local MongoDB container inside Docker.
# Pick any username and strong password — MongoDB will be created with these.
MONGO_INITDB_ROOT_USERNAME=bhivadmin
MONGO_INITDB_ROOT_PASSWORD=BHIV@Secure2025!
MONGO_INITDB_DATABASE=blackhole_wallet
MONGODB_URI=mongodb://bhivadmin:BHIV@Secure2025!@blackhole-mongodb:27017/blackhole_wallet

# ── Node Security ─────────────────────────────────────────────────────────────
# Set to true in production — requires real btcec wallet signatures on every tx
SIGVERIFY_STRICT_MODE=true
PDV_STRICT_MODE=true
SARATHI_FAIL_CLOSED=true

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
DOCKER_MODE=true

# ── TLS (Nginx) ───────────────────────────────────────────────────────────────
# Self-signed cert is already in nginx/certs/cert.pem
# For production replace with Let's Encrypt cert
TLS_CERT_PATH=./nginx/certs/cert.pem
TLS_KEY_PATH=./nginx/certs/key.pem

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_RPS=100

# ── Public RPC & Network ──────────────────────────────────────────────────────
RPC_DOMAIN=rpc.vajra.blackholeinfiverse.com
NETWORK_ID=vajra-mainnet

# ── Cross-Chain Bridge & Web3 ─────────────────────────────────────────────────
# Ethereum Mainnet RPC Provider (Infura, Alchemy, QuickNode)
ETHEREUM_RPC_URL=
# Polygon Amoy Testnet (active deployed contract fallback)
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_AMOY_CONTRACT=0x64Dd946E7425898FE8FaB6D36eA050071190be40
SOLANA_RPC_URL=https://api.devnet.solana.com

